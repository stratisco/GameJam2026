theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 15
text = "
- the same number of wires in the top and bottom half should be cut.

- if there are an even number of wires, white wires should be cut.

- any orange wires that are above white wires should not be cut.

- if there is a white wire, at least 3 wires should be cut.

- at most one of red and lime wires should be cut."
autowrap_mode = 2

