text = "How to safely turn off

Required Tools: Wire Cutters

Instructions: cut the correct wires. 

_______________________________

- if there are more than 8 wires, they should all be cut. 

- if a yellow wire is in the top half, it should be cut.

- if there are 2 wires with the same colour, neither should be cut.
"
autowrap_mode = 2

[node name="Label2" type="Label" parent="." unique_id=651411103]
offset_left = 1042.0
